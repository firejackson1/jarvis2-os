index 2b37c02..0f22c7f 100644
--- a/Android.bp
+++ b/Android.bp
@@ -244,6 +244,7 @@ libadb_linux_srcs = [
 ]
 
 libadb_test_srcs = [
+    "daemon/listener_policy_test.cpp",
     "adb_io_test.cpp",
     "adb_listeners_test.cpp",
     "adb_utils_test.cpp",
diff --git a/daemon/listener_policy.h b/daemon/listener_policy.h
new file mode 100644
index 0000000..cc70d2c
--- /dev/null
+++ b/daemon/listener_policy.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <cstdio>
+#include <string>
+
+// Zero means no TCP listener; retain sscanf's existing accepted port syntax.
+inline int AdbTcpListenPort(const std::string& property, bool is_usb, int default_port) {
+    int port;
+    if (std::sscanf(property.c_str(), "%d", &port) == 1 && port > 0) {
+        return port;
+    }
+#if defined(__ANDROID__)
+    // An explicit Android port setting disables fallback, including without USB.
+    // Keep the historical fallback for an unset property and for host adbd.
+    if (!property.empty()) return 0;
+#endif
+    return is_usb ? 0 : default_port;
+}
diff --git a/daemon/listener_policy_test.cpp b/daemon/listener_policy_test.cpp
new file mode 100644
index 0000000..1e2a0d0
--- /dev/null
+++ b/daemon/listener_policy_test.cpp
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#include "daemon/listener_policy.h"
+
+#include <gtest/gtest.h>
+
+TEST(AdbListenerPolicy, UnsetPortKeepsFallbackWithoutUsb) {
+    EXPECT_EQ(5555, AdbTcpListenPort("", false, 5555));
+    EXPECT_EQ(0, AdbTcpListenPort("", true, 5555));
+}
+
+TEST(AdbListenerPolicy, PositivePortKeepsExistingSyntaxWithAndWithoutUsb) {
+    for (bool usb : {false, true}) {
+        EXPECT_EQ(5556, AdbTcpListenPort("5556", usb, 5555));
+        EXPECT_EQ(5557, AdbTcpListenPort(" 5557suffix", usb, 5555));
+    }
+}
+
+TEST(AdbListenerPolicy, ExplicitNonpositivePortDisablesAndroidFallback) {
+    for (const auto* port : {"-1", "0", "invalid"}) {
+#if defined(__ANDROID__)
+        EXPECT_EQ(0, AdbTcpListenPort(port, false, 5555));
+#else
+        EXPECT_EQ(5555, AdbTcpListenPort(port, false, 5555));
+#endif
+        EXPECT_EQ(0, AdbTcpListenPort(port, true, 5555));
+    }
+}
