// SPDX-License-Identifier: Apache-2.0
// Link directly to the Settings resources from the same Android build.
runtime_resource_overlay {
    name: "Jarvis2TvControlsOverlay",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    resource_libs: ["TvSettingsTwoPanel"],
    aaptflags: ["--package-id", "0x7e", "--allow-reserved-package-id"],
    certificate: "platform",
    system_ext_specific: true,
}
