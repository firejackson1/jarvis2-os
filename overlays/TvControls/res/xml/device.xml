<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:custom="http://schemas.android.com/apk/prv/res/com.android.tv.settings"
                  android:title="@*com.android.tv.settings:string/device_pref_category_title">
    <Preference
        android:fragment="com.android.tv.settings.about.AboutFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_info_outline"
        android:key="about_device"
        android:title="@*com.android.tv.settings:string/about_preference"/>
    <Preference
        android:fragment="com.android.tv.settings.device.eco.PowerAndEnergyFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_settings_power_and_energy"
        custom:isPreferenceVisible="false"
        android:key="power_and_energy"
        android:title="@*com.android.tv.settings:string/power_and_energy"/>
    <Preference
        android:fragment="com.android.tv.settings.system.ButtonsFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_buttons"
        android:key="button_settings"
        android:title="@*com.android.tv.settings:string/system_buttons"/>
    <Preference
        android:fragment="com.android.tv.settings.system.DateTimeFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_access_time"
        android:key="date_time"
        android:title="@*com.android.tv.settings:string/system_date_time"/>
    <Preference
        android:fragment="com.android.tv.settings.system.locale.LanguagePickerFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_language"
        android:key="language"
        android:title="@*com.android.tv.settings:string/system_language"/>
    <Preference
        android:fragment="com.android.tv.settings.inputmethod.KeyboardFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_keyboard"
        android:key="keyboard"
        android:title="@*com.android.tv.settings:string/system_keyboard"/>
    <Preference
        android:fragment="com.android.tv.settings.system.InputsFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_input"
        android:key="inputs"
        android:title="@*com.android.tv.settings:string/system_inputs" />
    <Preference
        android:fragment="com.android.tv.settings.device.displaysound.DisplaySoundFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_display_sound"
        android:key="sound_effects"
        android:title="@*com.android.tv.settings:string/device_display_sound"/>
    <Preference
        android:fragment="com.android.tv.settings.device.StorageSummaryFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_storage"
        android:key="storage"
        android:title="@*com.android.tv.settings:string/device_storage"/>
    <Preference
        android:icon="@*com.android.tv.settings:drawable/ic_home"
        android:key="home"
        android:title="@*com.android.tv.settings:string/system_home">
        <intent android:action="com.google.android.tvlauncher.SETTINGS"/>
    </Preference>
    <Preference
        android:key="google_settings"
        android:title="@*com.android.tv.settings:string/system_google">
        <intent
            android:action="com.google.assistant.GOOGLE_SETTINGS"/>
    </Preference>
    <Preference
        android:icon="@*com.android.tv.settings:drawable/ic_cast"
        android:key="cast"
        android:title="@*com.android.tv.settings:string/system_cast" >
        <intent android:action="com.google.android.settings.CAST_RECEIVER_SETTINGS" />
    </Preference>
    <com.android.tv.twopanelsettings.slices.SlicePreference
        android:icon="@*com.android.tv.settings:drawable/ic_devices_other"
        android:key="fastpair_slice"
        android:title="@*com.android.tv.settings:string/device_fastpair"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/fastpair_slice_uri"/>
    <Preference
        android:fragment="com.android.tv.settings.device.display.daydream.DaydreamFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_settings_system_daydream"
        android:key="daydream"
        android:title="@*com.android.tv.settings:string/device_daydream"/>
    <Preference
        android:fragment="com.android.tv.settings.device.display.daydream.EnergySaverFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_settings_energy_saver"
        android:key="energysaver"
        android:title="@*com.android.tv.settings:string/device_energy_saver"/>
    <Preference
        android:fragment="com.android.tv.settings.system.development.DevelopmentFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_settings_developeroptions"
        android:key="developer"
        android:title="@*com.android.tv.settings:string/system_developer_options"/>
    <Preference
        android:fragment="com.android.tv.settings.system.LocationFragment"
        android:icon="@*com.android.tv.settings:drawable/ic_location_on"
        android:key="location"
        android:title="@*com.android.tv.settings:string/system_location"/>
    <Preference
        android:key="microphone"
        android:icon="@*com.android.tv.settings:drawable/ic_mic_on"
        android:title="@*com.android.tv.settings:string/microphone"
        android:fragment="com.android.tv.settings.privacy.MicrophoneFragment" />
    <Preference
        android:key="camera"
        android:icon="@*com.android.tv.settings:drawable/ic_camera_on"
        android:title="@*com.android.tv.settings:string/camera"
        android:fragment="com.android.tv.settings.privacy.SensorFragment" />
    <Preference
        android:icon="@*com.android.tv.settings:drawable/ic_timeline"
        android:key="usageAndDiag"
        android:title="@*com.android.tv.settings:string/system_diagnostic">
        <intent
            android:action="com.google.android.settings.USAGE_AND_DIAGNOSTICS_SETTING"/>
    </Preference>
    <com.android.tv.twopanelsettings.slices.SlicePreference
        android:icon="@*com.android.tv.settings:drawable/ic_internal_settings"
        android:key="overlay_internal"
        android:title="@*com.android.tv.settings:string/overlay_internal_slice_title"
        android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
        custom:isPreferenceVisible="false"
        custom:uri="@*com.android.tv.settings:string/overlay_internal_slice_uri"/>
</PreferenceScreen>
