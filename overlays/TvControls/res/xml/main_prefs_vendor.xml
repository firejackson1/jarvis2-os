<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
                  xmlns:custom="http://schemas.android.com/apk/prv/res/com.android.tv.settings"
                  android:title="@*com.android.tv.settings:string/settings_app_name">
    <!--
      The basic mode suggestion and the real suggested settings are mutually exclusive so it is safe
      for both of them to have android:order="0".
    -->
    <PreferenceCategory
        android:key="basic_mode_suggestion"
        android:title="@*com.android.tv.settings:string/basic_mode_suggestion_category_title"
        android:order="0" >
        <Preference
            android:key="basic_mode_exit"
            android:icon="@*com.android.tv.settings:drawable/ic_tv_x"
            android:title="@*com.android.tv.settings:string/basic_mode_exit_preference_title"
            android:summary="@*com.android.tv.settings:string/basic_mode_exit_preference_subtitle"
            android:fragment="com.android.tv.settings.basic.BasicModeExitSuggestionInfoFragment" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="general_settings"
        android:title="@*com.android.tv.settings:string/header_category_general_settings"
        android:order="2">

        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_settings_channels_and_inputs"
            android:key="channels_and_inputs"
            android:title="@*com.android.tv.settings:string/channels_and_inputs_title"
            android:summary="@*com.android.tv.settings:string/channels_and_inputs_summary"
            android:fragment="com.android.tv.settings.vendor.ChannelsAndInputFragment">
            <!-- This is an example. Change to your intent for display and preview-->
        </Preference>
        <com.android.tv.twopanelsettings.slices.SlicePreference
            android:icon="@*com.android.tv.settings:drawable/ic_settings_channels_and_inputs"
            android:key="channels_and_inputs_slice"
            android:title="@*com.android.tv.settings:string/channels_and_inputs_title"
            android:summary="@*com.android.tv.settings:string/channels_and_inputs_summary"
            android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
            custom:isPreferenceVisible="false"
            custom:uri="@*com.android.tv.settings:string/channels_and_inputs_slice_uri">
        </com.android.tv.twopanelsettings.slices.SlicePreference>

        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_photo_size_select_actual"
            android:key="display_and_sound"
            android:title="@*com.android.tv.settings:string/device_display_sound"
            android:fragment="com.android.tv.settings.vendor.DisplayPreviewFragment">
            <!-- This is an example. Change to your intent for display and preview-->
        </Preference>

        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_network"
            android:key="network"
            android:title="@*com.android.tv.settings:string/connectivity_network_category_title"
            android:fragment="com.android.tv.settings.connectivity.NetworkFragment" />
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_add_an_account"
            android:key="accounts_and_sign_in"
            android:title="@*com.android.tv.settings:string/accounts_category_title"
            android:fragment="com.android.tv.settings.accounts.AccountsFragment" />
        <com.android.tv.twopanelsettings.slices.SlicePreference
            android:icon="@*com.android.tv.settings:drawable/ic_add_an_account"
            android:key="accounts_and_sign_in_slice"
            android:title="@*com.android.tv.settings:string/accounts_category_title"
            android:fragment="com.android.tv.settings.accounts.AccountsSliceFragment"
            custom:uri="@*com.android.tv.settings:string/account_slice_uri"/>
        <Preference
            android:key="accounts_and_sign_in_basic_mode"
            android:icon="@*com.android.tv.settings:drawable/ic_add_an_account"
            android:title="@*com.android.tv.settings:string/accounts_category_title"
            android:summary="@*com.android.tv.settings:string/unavailable"
            android:fragment="com.android.tv.settings.basic.BasicModeAccountsAndSignInInfoFragment" />
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_volume_up"
            android:key="sound"
            android:title="@*com.android.tv.settings:string/sound_category_title"
            android:visible="false">
            <intent android:action="com.android.tv.settings.SOUND" />
        </Preference>
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_policy"
            android:key="privacy"
            android:title="@*com.android.tv.settings:string/privacy_category_title"
            android:fragment="com.android.tv.settings.privacy.PrivacyFragment"
            custom:isPreferenceVisible="false" />

        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_applications"
            android:key="applications"
            android:title="@*com.android.tv.settings:string/applications_category_title"
            android:fragment="com.android.tv.settings.device.apps.AppsFragment" />
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_device_prefs"
            android:key="device_pref"
            android:title="@*com.android.tv.settings:string/device_pref_category_title"
            android:fragment="com.android.tv.settings.device.DevicePrefFragment" />
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_accessibility_new"
            android:key="accessibility"
            android:title="@*com.android.tv.settings:string/accessibility_category_title"
            android:fragment="com.android.tv.settings.accessibility.AccessibilityFragment" />
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_remotes_and_accessories"
            android:key="remotes_and_accessories"
            android:title="@*com.android.tv.settings:string/remotes_and_accessories_category_title"
            android:fragment="com.android.tv.settings.accessories.AccessoriesFragment" >
            <intent
                android:targetClass="com.android.tv.settings.accessories.AddAccessoryActivity"
                android:targetPackage="com.android.tv.settings"/>
        </Preference>
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_remotes_and_accessories"
            android:key="connected_devices"
            android:title="@*com.android.tv.settings:string/remotes_and_accessories_category_title"
            android:visible="false">
            <intent
                android:action="com.android.tv.settings.CONNECTED_DEVICES" />
        </Preference>
        <com.android.tv.twopanelsettings.slices.SlicePreference
            android:icon="@*com.android.tv.settings:drawable/ic_remotes_and_accessories"
            android:key="connected_devices_slice"
            android:title="@*com.android.tv.settings:string/remotes_and_accessories_category_title"
            android:fragment="com.android.tv.twopanelsettings.slices.SliceFragment"
            custom:isPreferenceVisible="false"
            custom:uri="@*com.android.tv.settings:string/connected_devices_slice_uri"/>
        <Preference
            android:icon="@*com.android.tv.settings:drawable/ic_help_outline"
            android:key="help_and_feedback"
            android:title="@*com.android.tv.settings:string/help_and_feedback_category_title"
            android:fragment="com.android.tv.settings.help.HelpFragment">
        </Preference>
    <Preference android:key="jarvis_home" android:title="Home screen" android:icon="@*com.android.tv.settings:drawable/ic_home"><intent android:targetPackage="app.jarvis2.remote" android:targetClass="app.jarvis2.remote.LauncherSettings"></intent></Preference>
<Preference android:key="jarvis_controller_buttons" android:title="Remote &amp; controller buttons" android:icon="@*com.android.tv.settings:drawable/ic_buttons"><intent android:targetPackage="app.jarvis2.remote" android:targetClass="app.jarvis2.remote.ControllerSettings"></intent></Preference>
<Preference android:key="jarvis_voice" android:title="Smart Home" android:icon="@*com.android.tv.settings:drawable/ic_home"><intent android:targetPackage="app.jarvis2.remote" android:targetClass="app.jarvis2.remote.VoiceSettings"></intent></Preference>
<Preference android:key="jarvis_widgets" android:title="Widgets" android:icon="@*com.android.tv.settings:drawable/ic_home"><intent android:targetPackage="app.jarvis2.remote" android:targetClass="app.jarvis2.remote.RemotePreferences"></intent></Preference>
<Preference android:key="jarvis_audio" android:title="Sound output &amp; sync" android:icon="@*com.android.tv.settings:drawable/ic_volume_up"><intent android:targetPackage="app.jarvis2.remote" android:targetClass="app.jarvis2.remote.Panel"><extra android:name="page" android:value="audio"/><extra android:name="entry" android:value="main-settings"/></intent></Preference>
</PreferenceCategory>
</PreferenceScreen>
