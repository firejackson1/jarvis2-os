# SPDX-License-Identifier: Apache-2.0
DEVICE_PATH := device/onn/jarvis2
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := $(DEVICE_PATH)/framework-compatibility-matrix.xml
JARVIS2_STOCK := vendor/onn/jarvis2/stock

TARGET_BOOTLOADER_BOARD_NAME := jarvis2
TARGET_NO_BOOTLOADER := true
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_CPU_VARIANT := generic
TARGET_IS_64_BIT_KERNEL := true

TARGET_PREBUILT_KERNEL := $(JARVIS2_STOCK)/kernel
BOARD_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_MKBOOTIMG_INIT_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_USES_METADATA_PARTITION := true
BOARD_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 8388608
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_DTBOIMG_PARTITION_SIZE := 2097152

BOARD_SUPER_PARTITION_SIZE := 3355443200
BOARD_SUPER_PARTITION_GROUPS := amlogic_dynamic_partitions
BOARD_AMLOGIC_DYNAMIC_PARTITIONS_SIZE := 3344957440
BOARD_AMLOGIC_DYNAMIC_PARTITIONS_PARTITION_LIST := \
    odm odm_dlkm product system system_dlkm system_ext vendor vendor_dlkm
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
TARGET_COPY_OUT_SYSTEM_EXT := system_ext
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_ODM := odm
TARGET_COPY_OUT_ODM_DLKM := odm_dlkm
TARGET_COPY_OUT_SYSTEM_DLKM := system_dlkm
TARGET_COPY_OUT_VENDOR_DLKM := vendor_dlkm

BOARD_PREBUILT_VENDORIMAGE := $(JARVIS2_STOCK)/images/vendor.img
BOARD_PREBUILT_ODMIMAGE := $(JARVIS2_STOCK)/images/odm.img
BOARD_PREBUILT_DTBOIMAGE := $(JARVIS2_STOCK)/images/dtbo.img
BOARD_PREBUILT_ODM_DLKMIMAGE := $(JARVIS2_STOCK)/images/odm_dlkm.img
BOARD_PREBUILT_SYSTEM_DLKMIMAGE := $(JARVIS2_STOCK)/images/system_dlkm.img
BOARD_PREBUILT_VENDOR_DLKMIMAGE := $(JARVIS2_STOCK)/images/vendor_dlkm.img

# Use the compression settings validated during slot-A image fitting.
BOARD_EROFS_COMPRESSOR := lz4hc,12
BOARD_EROFS_PCLUSTER_SIZE := 65536
TARGET_USERIMAGES_SPARSE_EROFS_DISABLED := true
