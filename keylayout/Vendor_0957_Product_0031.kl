# Jarvis2 onn remote mapping from observed Linux key codes and HID usages.
# Keep native Power/Voice behavior when the optional shortcut service is off.
key 116 POWER WAKE
key 217 VOICE_ASSIST WAKE
key 103 DPAD_UP
key 108 DPAD_DOWN
key 105 DPAD_LEFT
key 106 DPAD_RIGHT
key 353 DPAD_CENTER
key 158 BACK
key 172 HOME WAKE
key 113 VOLUME_MUTE
key 114 VOLUME_DOWN
key 115 VOLUME_UP
key usage 0x000c01BB TV_INPUT
key usage 0x000c0186 MACRO_1 WAKE
key usage 0x000c0187 FEATURED_APP_1 WAKE
key usage 0x000c022A PROFILE_SWITCH
key usage 0x000c019C PROFILE_SWITCH
key usage 0x000c009F F12
key usage 0x000c008D GUIDE
key usage 0x000c009C CHANNEL_UP
key usage 0x000c009D CHANNEL_DOWN
key usage 0x000c0077 BUTTON_3 WAKE
key usage 0x000c0078 BUTTON_4 WAKE
key usage 0x000c0079 BUTTON_9 WAKE
key usage 0x000c007A BUTTON_10 WAKE
